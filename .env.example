# Supabase (obrigatório para scripts e API)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# n8n webhook (process-edital-info, improve-text, etc.) — usado se USE_OLLAMA não for true
N8N_WEBHOOK_URL=https://n8n.srv652789.hstgr.cloud/webhook/basic
N8N_WEBHOOK_TIMEOUT_MS=240000

# AI Secretary — tunnel para Ollama (geração de campos no editor de proposta)
# Quando definido, /api/generate-field-text usa esse endpoint com contexto RAG + edital + usuário
# AI_SECRETARY_URL=https://aisecretary.com
# AI_SECRETARY_MODEL=qwen2.5:7b
# AI_SECRETARY_MAX_CONTEXT_CHARS=22000
# --- Mais contexto no editor (geração de campos): suba estes valores junto com AI_SECRETARY_MAX_CONTEXT_CHARS ---
# GEN_FIELD_EXISTING_DOC_CHARS=14000
# GEN_FIELD_EDITAL_DESCR_MAX=4000
# GEN_FIELD_EDITAL_CRITERIOS_MAX=4000
# GEN_FIELD_EDITAL_SOBRE_MAX=3000
# Use true se o tunnel apresentar certificado de outro domínio (ex.: ERR_TLS_CERT_ALTNAME_INVALID)
# AI_SECRETARY_INSECURE=true

# Ollama local (api:process-edital-info-null e process-edital-info)
USE_OLLAMA=true
# Local dev: http://localhost:11434
# Docker Compose: o scheduler fala com o serviço "ollama" via http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434
# Não use https://…:11434 — o Ollama fala HTTP nessa porta; com https o Node dá «fetch failed» em POST (/api/embed, /api/generate). HTTPS só se houver proxy na 443.
# Modelo: 7B é mais preciso mas lento; modelos menores = mais rápido (phi3.5, llama3.2:1b, tinyllama)
OLLAMA_MODEL=qwen2.5:7b
# Atenção ao nome: é **qwen**, não "qween" — typo comum faz o Ollama responder «model not found».
# Timeout: Ollama local (CPU) é lento; Gemini funciona bem pois roda em GPU na nuvem
OLLAMA_TIMEOUT_MS=120000
# Contexto: use 15000–22000 para evitar timeout em CPU (8 PDFs = muitos chunks)
OLLAMA_MAX_CONTEXT_CHARS=22000
# Prefácio antes do CONTEÚDO no /api/generate — default é curto (mais espaço ao texto do edital). Use `long` para o texto longo antigo (4 linhas).
# OLLAMA_PROMPT_PREAMBLE=long
# RAG (process-edital-info): quantos chunks da tabela documents enviamos no prompt por vez (ex.: 25).
# Não limita o que é salvo: cada PDF tem todos os trechos em documents (populate-documents-from-pdfs).
# OLLAMA_MAX_CHUNKS=25
# RAG: usar tabela documents (por file_id) como contexto. Se 0/false, usa extração direta do PDF.
OLLAMA_USE_RAG=true
# CRAG (Corrective RAG): default 1 = uma embedding + match_documents por chamada; em JSON inválido ou resposta vazia, corrige-se a ragQuery.
# Com CRAG ligado, OLLAMA_RAG_TRY_MULTIPLE_TOPK não corre na 1.ª passagem (um só top_k). 0/false/off = permite vários top_k na 1.ª passagem.
# OLLAMA_RAG_CRAG=0
# Heurísticas só fora do vector top-k: concat de `documents` (omitir chunks tipo Código de Conduta). 0=desliga.
# OLLAMA_RAG_DOCUMENTS_CONCAT_FILTER=0
# Ordenar PDFs no storage por nome (edital antes de conduta/integridade). 0=ordem original dos ids.
# OLLAMA_PDF_CONTEXT_SORT_HEURISTIC=0
# Contagens em `documents` quando RAG falha (pgvector/concat). 0=desliga o log de diagnóstico.
# OLLAMA_LOG_RAG_DIAG=0
# process-edital-info: omitir PDFs por nome (conduta/anexo). 0=lista completa de PDFs para extração/RAG.
# OLLAMA_EXTRACT_PDF_NOME_FILTER=0
# RAG: modo de busca (topk = pgvector via RPC match_documents; concat = concatena conteúdo por file_id).
OLLAMA_RAG_MODE=topk
# Default 1 = um chunk por busca (menos carga/embed + um /api/generate no modo topk sem extras). Suba se precisar de mais recall.
OLLAMA_RAG_TOP_K=1
# Limite de caracteres da consulta enviada ao /api/embed (RAG). Default 1200; suba se ver «query embedding truncada» com corte grande.
# OLLAMA_RAG_QUERY_MAX_CHARS=2400
# Só `documents.content` (não tenta colunas legadas data/value/text/…). Útil se o schema só tem `content`.
# OLLAMA_RAG_CONTENT_ONLY=1
# Vários top_k em sequência (cada k refaz RAG + gerações). Ver scripts/lib/ollama-edital.ts.
# OLLAMA_RAG_TRY_MULTIPLE_TOPK=1
# OLLAMA_RAG_TOP_K_TRY=6,12,24
# USE_OLLAMA: se a resposta não tiver JSON aceitável para o campo, nova chamada com o mesmo texto da pergunta e outro top_k no RAG (lista em ordem). Vazio/0/false/off = desligado.
# OLLAMA_RAG_INVALID_RETRY_TOP_K=12,24,36
# Com as retentativas acima: outra janela aleatória (crypto) sobre o texto completo disponível, alinhada a quebras; não usa recorte lexical nem heurísticas de trecho. 0 = só mudar top_k.
# OLLAMA_RAG_INVALID_RETRY_CONTENT_SHIFT=1
# Se 1: `{"valor":null}` sem «R$» na prosa da resposta também conta como “inválido” e dispara retentativas (default 0 = só null+prosa contraditória ou JSON malformado).
# OLLAMA_RAG_INVALID_RETRY_INCLUDE_EXPLICIT_NULL_VALOR=1
# Se 1 (default): `{"prazos":[]}` conta como “inválido” e dispara retentativas (útil quando o RAG pegou o trecho errado).
# OLLAMA_RAG_INVALID_RETRY_INCLUDE_EMPTY_PRAZO=0
# OLLAMA_TRUNCATION_WINDOW_MAX_N=5
# Retentativas quando `prazo_inscricao` vem com datas que a ancoragem remove (alucinação). Chamadas extra ao /api/generate; 0=desligar; máx. 3.
# OLLAMA_PRAZO_ANCHOR_RETRY=1
# Se após ancoragem `prazos` ficar vazio, extrair DD/MM/AAAA do próprio texto perto de submissão/cronograma (ex.: FAPESC). 0=desligar.
# OLLAMA_PRAZO_SOURCE_HEURISTIC=1
# OLLAMA_VERBOSE=1
# --- Mais contexto no process-edital-info (Ollama local) ---
# 1) Suba OLLAMA_MAX_CONTEXT_CHARS (ex.: 45000) se tiver GPU ou paciência em CPU.
# 2) Deixe OLLAMA_MAX_CHUNKS comentado = usa todos os chunks até caber no limite de chars.
#    Ou defina um número alto (ex.: 80) se quiser teto explícito.
# 3) OLLAMA_NUM_CTX deve ser >= janela do modelo (tokens). ~4 chars ≈ 1 token em PT.
#    qwen2.5:7b suporta 32k+; exemplo: OLLAMA_NUM_CTX=32768 (mais VRAM).
# 4) Aumente OLLAMA_TIMEOUT_MS (ex.: 300000) se der timeout.
# OLLAMA_NUM_CTX=32768
# OLLAMA_NUM_PREDICT=256
# Temperatura no /api/generate da extração (editais). 0 = mais determinístico (recomendado; equivale a `ollama run … --temperature 0`).
# OLLAMA_TEMPERATURE=0

# --- Ensemble (varrer o documento inteiro em janelas) ---
# Use quando uma única chamada não encontra o trecho certo.
#
# Modo recomendado (N automático, cobre o documento inteiro):
# OLLAMA_GENERATION_ENSEMBLE_AUTO=1
# OLLAMA_GENERATION_ENSEMBLE_MAX_N=30
# OLLAMA_GENERATION_ENSEMBLE_OVERLAP=0.18
#
# Alternativa (N fixo):
# OLLAMA_GENERATION_ENSEMBLE_N=5
# OLLAMA_GENERATION_ENSEMBLE_USE_FULL_CONTEXT=1
#
# Quando NÃO usar full context (para limitar a busca ao começo do texto):
# OLLAMA_GENERATION_ENSEMBLE_POOL_MULT=3
#
# Scan determinístico do documento inteiro (janelas sequenciais a partir do início, com múltiplas passadas).
# Default: ligado (1). Só ativa quando o texto excede OLLAMA_MAX_CONTEXT_CHARS.
# OLLAMA_FULL_DOCUMENT_SCAN=1
# OLLAMA_FULL_DOCUMENT_SCAN_PASSES=2
# Teto de janelas por chamada (evita explodir em dezenas de requests, ex. 52):
# OLLAMA_FULL_DOCUMENT_SCAN_MAX_WINDOWS=8

# Embeddings (db:embed-documents): Ollama (padrão) ou OpenAI
OLLAMA_EMBED_MODEL=mxbai-embed-large:latest
# Se a coluna embedding no banco for vector(768), use para não alterar o banco:
# EMBED_DIMENSIONS=768
# OPENAI_API_KEY=sk-...
# OPENAI_EMBED_MODEL=text-embedding-3-small
# EMBED_MAX_CHARS=24000
# Nome da coluna de texto em documents (se não for content/text/body/page_content/chunk/data/value):
# EMBED_CONTENT_COLUMN=page_content

# PDF → chunks → documents (db:populate-documents-from-pdfs)
# CHUNK_SIZE=800
# CHUNK_OVERLAP=200
# Limites por request ao Ollama (evitam "input length exceeds the context length")
# EMBED_BATCH_SIZE=8
# EMBED_MAX_CHARS_PER_BATCH=2048
# Máximo de caracteres por string no embed (mxbai tem limite por entrada; padrão 512)
# EMBED_MAX_CHARS_PER_INPUT=512

# Scraper CNPq (npm run scrape:cnpq) — URL da listagem; padrão: memoria2.cnpq.br/web/guest/chamadas-publicas
# CNPQ_CHAMADAS_URL=http://memoria2.cnpq.br/web/guest/chamadas-publicas

# Opcional: delay entre requisições (ms)
# API_REQUEST_DELAY_MS=12000
# DELAY_BETWEEN_EDITAIS_MS=30000
