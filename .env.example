# Supabase (obrigatório para scripts e API)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# n8n webhook (process-edital-info, improve-text, etc.) — usado se USE_OLLAMA não for true
N8N_WEBHOOK_URL=https://n8n.srv652789.hstgr.cloud/webhook/basic
N8N_WEBHOOK_TIMEOUT_MS=240000

# Ollama local (api:process-edital-info-null e process-edital-info)
USE_OLLAMA=true
OLLAMA_BASE_URL=http://localhost:11434
# Modelo: 7B é mais preciso mas lento; modelos menores = mais rápido (phi3.5, llama3.2:1b, tinyllama)
OLLAMA_MODEL=qwen2.5:7b
# Timeout: Ollama local (CPU) é lento; Gemini funciona bem pois roda em GPU na nuvem
OLLAMA_TIMEOUT_MS=120000
# Contexto: use 15000–22000 para evitar timeout em CPU (8 PDFs = muitos chunks)
OLLAMA_MAX_CONTEXT_CHARS=22000
# Limite de chunks enviados (ex.: 25); evita contexto gigante com vários PDFs
# OLLAMA_MAX_CHUNKS=25
# RAG: usar tabela documents (por file_id) como contexto. Se 0/false, usa extração direta do PDF.
OLLAMA_USE_RAG=true
# OLLAMA_VERBOSE=1
# OLLAMA_NUM_CTX=8192
# OLLAMA_NUM_PREDICT=256

# Embeddings (db:embed-documents): Ollama (padrão) ou OpenAI
# OLLAMA_EMBED_MODEL=mxbai-embed-large:latest
# Se a coluna embedding no banco for vector(768), use para não alterar o banco:
# EMBED_DIMENSIONS=768
# OPENAI_API_KEY=sk-...
# OPENAI_EMBED_MODEL=text-embedding-3-small
# EMBED_MAX_CHARS=24000
# Nome da coluna de texto em documents (se não for content/text/body/page_content/chunk/data/value):
# EMBED_CONTENT_COLUMN=page_content

# PDF → chunks → documents (db:populate-documents-from-pdfs)
# CHUNK_SIZE=800
# CHUNK_OVERLAP=200

# Opcional: delay entre requisições (ms)
# API_REQUEST_DELAY_MS=12000
# DELAY_BETWEEN_EDITAIS_MS=30000
